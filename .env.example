# Copie este ficheiro para ".env" (instalação local) ou defina estas variáveis no painel da Vercel.

# Obrigatório — a password para entrar na aplicação (pode mudá-la depois em Definições → Password)
FLYNOTES_PASSWORD=

# Obrigatório na Vercel — texto aleatório longo, usado para assinar as sessões
SESSION_SECRET=

# Criadas automaticamente pela Vercel ao ligar o armazenamento (não preencher à mão):
#   DATABASE_URL            → base de dados Neon (Postgres)
#   BLOB_READ_WRITE_TOKEN   → armazenamento Blob privado (anexos e cópias de segurança)

# Opcional — notificações push (lembretes com a aplicação fechada). Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:o-seu-email@exemplo.com

# Opcional — protege /api/cron (lembretes ao minuto através de um serviço externo como cron-job.org)
CRON_SECRET=

# Opcional — instalação local: porta do servidor (predefinição 5173) e pasta dos dados (predefinição .data)
PORT=
FLYNOTES_DATA_DIR=
