{
  "manifest_version": 3,
  "name": "FlyNotes Web Clipper",
  "short_name": "FlyNotes",
  "version": "1.0.0",
  "description": "Guarde páginas, artigos, seleções e capturas de ecrã nas suas notas FlyNotes.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Guardar na FlyNotes", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Abrir o Web Clipper da FlyNotes" } }
}
